{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "verbatimModuleSyntax": true
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
