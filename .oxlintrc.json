{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-non-null-assertion": "warn",
    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "ignorePatterns": [
    "dist/",
    "coverage/",
    "packages/protocol/src/generated/",
    "apps/loop-mobile/ios/",
    "apps/loop-mobile/showcase/",
    "apps/loop-mobile/showcase-captures/",
    "scripts/",
    "tests/",
    "pi-extensions/",
    "docs/"
  ]
}
